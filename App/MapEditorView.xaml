<UserControl x:Class="Berwick.Workshop.MapEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="200"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="250" MinWidth="200"/></Grid.ColumnDefinitions>
      <GridSplitter Grid.Column="1" Grid.Row="1" Width="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" ToolTip="Drag to resize" Focusable="False"/>
      <GridSplitter Grid.Column="3" Grid.Row="1" Width="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" ToolTip="Drag to resize" Focusable="False"/>
     <Border Grid.ColumnSpan="5" Background="#EAF0E5" CornerRadius="5" Padding="14,12,14,12" Margin="0,0,0,14">
      <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                 Text="View each battle's map, terrain, starting units, later arrivals, deployment positions and event spots. Hover over a hex for details. Use Restore original position to put back a starting unit removed in this project, or to remove one."/>
     </Border>
     <ListBox Grid.Row="1" x:Name="MapList" SelectionChanged="OnBattleSelected" BorderBrush="{StaticResource Line}" DisplayMemberPath="Text" SelectedValuePath="Value" AutomationProperties.Name="Battles"/>
     <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10,12,0">
        <CheckBox x:Name="MapArtBox" Content="Map art" IsChecked="True" Click="OnOptionsChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="The map as it is painted in the game"/>
        <CheckBox x:Name="MapTerrainBox" Content="Terrain colors" IsChecked="False" Click="OnOptionsChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Color each hex by its terrain"/>
        <CheckBox x:Name="MapUnitsBox" Content="Units" IsChecked="True" Click="OnOptionsChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Show where units stand when the battle starts"/>
        <CheckBox x:Name="MapArrivalsBox" Content="Arrivals" IsChecked="True" Click="OnOptionsChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Show where units arrive later, and on which turn"/>
        <CheckBox x:Name="MapMoveBox" Content="Move units" IsChecked="False" Click="OnOptionsChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Click a unit, then click the hex where it should start the battle"/>
        <CheckBox x:Name="MapDeployBox" Content="Edit deployment" IsChecked="False" Click="OnOptionsChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Click hexes to add or remove places where your units can start"/>
        <TextBlock Text="Size" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
        <ComboBox x:Name="MapSizeBox" Width="90" SelectedIndex="1" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Map size">
         <ComboBoxItem Content="Small"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Large"/>
        </ComboBox>
       </StackPanel>
       <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="MapCanvas" Margin="12" ClipToBounds="True" AutomationProperties.Name="Battle map" PreviewMouseLeftButtonDown="OnCanvasLeftClicked" PreviewMouseRightButtonDown="OnCanvasRightClicked" Background="Transparent"/></ScrollViewer>
      </DockPanel>
     </Border>
     <Border Grid.Row="1" Grid.Column="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
       <Border x:Name="MapUnitBox" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
        <StackPanel>
         <DockPanel Margin="0,0,0,6"><Button x:Name="EditMapUnitButton" DockPanel.Dock="Right" Content="Edit" Style="{StaticResource SmallButton}" Click="OnEditUnitRequested" ToolTip="Edit this unit (Ctrl+E)" Visibility="Collapsed"/><TextBlock Text="SELECTED UNIT" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
         <TextBlock x:Name="MapUnitName" FontFamily="Georgia" FontSize="18" TextWrapping="Wrap"/>
         <StackPanel x:Name="MapUnitFields"/>
         <StackPanel x:Name="MapUnitEditorPanel" Visibility="Collapsed"/>
        </StackPanel>
       </Border>
       <Button x:Name="StartingPlacementsButton" Content="Restore original position..." Style="{StaticResource SmallButton}" Click="OnStartingPlacementsRequested" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,0,10"/>
       <StackPanel x:Name="MapDetails"/>
      </StackPanel></ScrollViewer>
     </Border>
     <TextBlock Grid.Row="2" Grid.ColumnSpan="5" x:Name="MapCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
