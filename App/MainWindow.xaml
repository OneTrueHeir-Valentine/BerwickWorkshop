<Window x:Class="Berwick.Workshop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Berwick Workshop" Width="1300" Height="840" MinWidth="1060" MinHeight="680" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#253A31" Padding="22,30,22,20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Border Width="36" Height="40" HorizontalAlignment="Left" BorderBrush="#B7C7AD" BorderThickness="1" CornerRadius="4,4,14,14" Margin="0,0,0,18"><TextBlock Text="B" FontFamily="Georgia" FontSize="25" Foreground="#DAD8B8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="BERWICK" Foreground="#F7F6EC" FontFamily="Georgia" FontSize="22"/>
     <TextBlock Text="WORKSHOP" Foreground="#C1CBB9" FontSize="11" Margin="1,5,0,38"/>
     <Button x:Name="ItemsNav" Content="_Items" Style="{StaticResource NavButton}" Background="#3C5445" Click="ShowItems"/>
     <Button x:Name="CharactersNav" Content="C_haracters" Style="{StaticResource NavButton}" Click="ShowCharacters" IsEnabled="False"/>
     <Button x:Name="ArmiesNav" Content="_Armies" Style="{StaticResource NavButton}" Click="ShowArmies" IsEnabled="False"/>
     <Button x:Name="ClassesNav" Content="C_lasses" Style="{StaticResource NavButton}" Click="ShowClasses" IsEnabled="False"/>
     <Button x:Name="MovementNav" Content="Mo_vement" Style="{StaticResource NavButton}" Click="ShowMovement" IsEnabled="False"/>
     <Button x:Name="TerrainNav" Content="_Terrain" Style="{StaticResource NavButton}" Click="ShowTerrain" IsEnabled="False"/>
     <Button x:Name="FurnitureNav" Content="_Furniture" Style="{StaticResource NavButton}" Click="ShowFurniture" IsEnabled="False"/>
     <Button x:Name="ShopsNav" Content="_Shops" Style="{StaticResource NavButton}" Click="ShowShops" IsEnabled="False"/>
     <Button x:Name="SkillsNav" Content="S_kills" Style="{StaticResource NavButton}" Click="ShowSkills" IsEnabled="False"/>
     <Button x:Name="RulesNav" Content="_Rules" Style="{StaticResource NavButton}" Click="ShowRules" IsEnabled="False"/>
     <Button x:Name="MapsNav" Content="Ma_ps" Style="{StaticResource NavButton}" Click="ShowMaps" IsEnabled="False"/>
     <Button x:Name="EventsNav" Content="Eve_nts" Style="{StaticResource NavButton}" Click="ShowEvents" IsEnabled="False"/>
     <Button x:Name="LiveNav" Content="Live _game" Style="{StaticResource NavButton}" Click="ShowLive" IsEnabled="False"/>
     <Button x:Name="MechanicsNav" Content="_Mechanics" Style="{StaticResource NavButton}" Click="ShowMechanics"/>
     <Button x:Name="DiscNav" Content="_Disc details" Style="{StaticResource NavButton}" Click="ShowDisc"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Border Height="1" Background="#496050" Margin="0,0,0,18"/>
     <TextBlock Text="SAFE EDITING" Foreground="#C6D3BD" FontSize="10" FontWeight="SemiBold"/>
     <TextBlock Text="Edits are saved to a project file. Your game files stay untouched." Foreground="#AFC1B0" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,18"/>
     <Button Content="_Help" Style="{StaticResource NavButton}" Click="ShowHelp"/>
     <TextBlock Text="Version 0.79.0" Foreground="#9BAE9B" FontSize="11" Margin="0,10,0,0"/>
    </StackPanel>
    <Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="CompareButton" Content="_Compare ISO" Click="OpenComparison" IsEnabled="False" Margin="0,0,10,0" ToolTip="Compare another disc (Ctrl+Shift+O)"/>
     <Button x:Name="OpenButton" Content="_Open ISO" Click="OpenPrimary" Style="{StaticResource PrimaryButton}" ToolTip="Open a game disc (Ctrl+O)"/>
    </StackPanel>
    <StackPanel><TextBlock x:Name="PageTitle" Text="Item library" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Berwick Saga · Lazberia Chronicle, Chapter 174" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,12,0"/></StackPanel>
   </DockPanel>
   <Border Grid.Row="1" x:Name="DiscStrip" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="EditionText" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="FileText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
     <StackPanel x:Name="ProjectPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="12,0,0,0">
      <StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock x:Name="ProjectName" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/><TextBlock x:Name="ProjectState" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></StackPanel>
      <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource SmallButton}" Click="UndoEdit" ToolTip="Undo (Ctrl+Z)"/>
      <Button x:Name="RedoButton" Content="Redo" Style="{StaticResource SmallButton}" Click="RedoEdit" ToolTip="Redo (Ctrl+Y)"/>
      <Button x:Name="OpenProjectButton" Content="Open project" Style="{StaticResource SmallButton}" Click="OpenProject" ToolTip="Open a saved project"/>
      <Button x:Name="SaveProjectButton" Content="Save project" Style="{StaticResource SmallButton}" Click="SaveProject" ToolTip="Save project (Ctrl+S)"/>
      <Button x:Name="ExportButton" Content="Export disc" Style="{StaticResource SmallButton}" Click="ExportDisc" ToolTip="Write a patched copy of the disc"/>
     </StackPanel>
     <TextBlock x:Name="VerifiedText" Grid.Column="2" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
   </Border>
   <Border Grid.Row="2" x:Name="MessageBar" Visibility="Collapsed" Background="#FFF1D9" BorderBrush="#DFCC9E" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Padding="8,3" Click="DismissMessage" Margin="12,0,0,0"/><TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#725221" VerticalAlignment="Center"/></DockPanel></Border>
   <Grid Grid.Row="3">
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Margin="20">
     <Border BorderBrush="#8EA58E" BorderThickness="2" Width="68" Height="68" CornerRadius="34" Margin="0,0,0,24"><Border BorderBrush="#8EA58E" BorderThickness="2" Width="18" Height="18" CornerRadius="9"/></Border>
     <TextBlock Text="Open a game disc" FontFamily="Georgia" FontSize="30" HorizontalAlignment="Center"/>
     <TextBlock Text="Browse items, characters and classes, inspect your edition, and compare data between discs." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="15" LineHeight="23" Margin="0,15,0,24"/>
     <Button x:Name="EmptyOpenButton" Content="Choose an _ISO" Click="OpenPrimary" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="24,12"/>
     <TextBlock Text="Japanese retail and English v2.3" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,20,0,6"/>
     <TextBlock Text="You can also drop an ISO into this window." Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
    </StackPanel>
    <Grid x:Name="ItemPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,10,0"><TextBox x:Name="Search" TextChanged="FilterChanged" AutomationProperties.Name="Search items" ToolTip="Search by name or ID (Ctrl+F)"/><TextBlock x:Name="SearchHint" Text="Search by name or ID" IsHitTestVisible="False" Foreground="#899286" VerticalAlignment="Center" Margin="12,0"/></Grid>
      <ComboBox Grid.Column="1" x:Name="Category" SelectionChanged="CategoryChanged" AutomationProperties.Name="Item category"/>
      <CheckBox Grid.Column="2" x:Name="Unused" Content="Show unused" Margin="16,0,0,0" VerticalAlignment="Center" Checked="UnusedChanged" Unchecked="UnusedChanged"/>
      <Button Grid.Column="3" x:Name="NewItemButton" Content="_New item" Style="{StaticResource SmallButton}" Margin="14,0,0,0" Click="NewItem" ToolTip="Create a new item in a free slot (Ctrl+N)" Visibility="Collapsed"/>
     </Grid>
     <Border Grid.Row="1" x:Name="ComparisonBar" Visibility="Collapsed" Background="#EAF0E5" CornerRadius="5" Padding="12" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Padding="8,3" Click="RemoveComparison" Margin="10,0,0,0"/><CheckBox x:Name="OnlyDifferences" DockPanel.Dock="Right" Content="Differences only" Margin="12,0" VerticalAlignment="Center" Checked="UnusedChanged" Unchecked="UnusedChanged"/><TextBlock x:Name="ComparisonText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/></DockPanel></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <Grid>
        <DataGrid x:Name="ItemGrid" SelectionChanged="ItemSelected" AutomationProperties.Name="Items">
         <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding Item.IdText}" Width="78" MinWidth="78"/>
          <DataGridTextColumn Header="Item" Binding="{Binding Item.DisplayName}" Width="*" MinWidth="140"/>
          <DataGridTextColumn Header="Type" Binding="{Binding Item.Category}" Width="100" MinWidth="100"/>
          <DataGridTextColumn Header="Might" Binding="{Binding Item.Might}" Width="70" MinWidth="70"/>
          <DataGridTextColumn Header="Price" Binding="{Binding Item.Price, StringFormat=N0}" Width="82" MinWidth="82"/>
          <DataGridTextColumn Header="Status" Binding="{Binding EditedText}" Width="78" MinWidth="78"/>
          <DataGridTextColumn x:Name="ChangeColumn" Header="Comparison" Binding="{Binding Comparison}" Visibility="Collapsed" Width="100" MinWidth="100"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoResults" Text="No items match these filters." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="18">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
        <DockPanel Margin="0,0,0,14"><Button x:Name="EditItemButton" DockPanel.Dock="Right" Content="_Edit" Style="{StaticResource SmallButton}" Click="BeginEdit" ToolTip="Edit this item (Ctrl+E)" Visibility="Collapsed"/><TextBlock Text="ITEM DETAILS" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock x:Name="ItemName" Text="Select an item" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap"/>
        <TextBlock x:Name="ItemIdentity" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,16" TextWrapping="Wrap"/>
        <StackPanel x:Name="DetailFields"/>
        <StackPanel x:Name="EditorPanel" Visibility="Collapsed"/>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,12"/>
        <TextBlock Text="Effect" Style="{StaticResource Caption}"/><TextBlock x:Name="ItemEffect" TextWrapping="Wrap" Margin="0,5,0,12"/>
        <TextBlock x:Name="ItemComparisonText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <TextBlock Grid.Row="3" x:Name="ItemCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="ArmyPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid><TextBox x:Name="ArmySearch" TextChanged="ArmyFilterChanged" AutomationProperties.Name="Search armies" ToolTip="Search by unit name, class or army number (Ctrl+F)"/><TextBlock x:Name="ArmySearchHint" Text="Search by unit name, class or army number" IsHitTestVisible="False" Foreground="#899286" VerticalAlignment="Center" Margin="12,0"/></Grid>
      <CheckBox Grid.Column="1" x:Name="NamedUnitsOnly" Content="Named units only" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Checked="ArmyOptionChanged" Unchecked="ArmyOptionChanged" ToolTip="Show only units with a name of their own, such as bosses and leaders"/>
     </Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <Grid>
        <DataGrid x:Name="ArmyGrid" SelectionChanged="ArmyUnitSelected" AutomationProperties.Name="Army units" EnableRowVirtualization="True">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Army" Binding="{Binding ArmyLabel}" Width="1.6*" MinWidth="120"/>
          <DataGridTextColumn Header="Unit" Binding="{Binding Name}" Width="*" MinWidth="120"/>
          <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="1.3*" MinWidth="150"/>
          <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="56" MinWidth="56"/>
          <DataGridTextColumn Header="Drops" Binding="{Binding Drops}" Width="1.2*" MinWidth="120"/>
          <DataGridTextColumn Header="Status" Binding="{Binding EditedText}" Width="74" MinWidth="74"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoArmyUnits" Text="No units match this search." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="18">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
        <DockPanel Margin="0,0,0,14"><Button x:Name="EditArmyUnitButton" DockPanel.Dock="Right" Content="_Edit" Style="{StaticResource SmallButton}" Click="BeginArmyUnitEdit" ToolTip="Edit this unit (Ctrl+E)" Visibility="Collapsed"/><TextBlock Text="UNIT DETAILS" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock x:Name="ArmyUnitName" Text="Select a unit" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap"/>
        <TextBlock x:Name="ArmyUnitIdentity" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,6" TextWrapping="Wrap"/>
        <StackPanel x:Name="ArmyUnitFields"/>
        <StackPanel x:Name="ArmyUnitEditorPanel" Visibility="Collapsed"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <TextBlock Grid.Row="2" x:Name="ArmyCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="CharacterPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid><TextBox x:Name="CharacterSearch" TextChanged="CharacterFilterChanged" AutomationProperties.Name="Search characters" ToolTip="Search by name or ID (Ctrl+F)"/><TextBlock x:Name="CharacterSearchHint" Text="Search by name or ID" IsHitTestVisible="False" Foreground="#899286" VerticalAlignment="Center" Margin="12,0"/></Grid>
      <Button Grid.Column="1" x:Name="RandomizeItemsButton" Content="_Randomize items" Style="{StaticResource SmallButton}" Margin="14,0,0,0" Click="RandomizeItems" ToolTip="Give characters random starting items" Visibility="Collapsed"/>
     </Grid>
     <Border Grid.Row="1" x:Name="CharacterComparisonBar" Visibility="Collapsed" Background="#EAF0E5" CornerRadius="5" Padding="12" Margin="0,0,0,12"><DockPanel><CheckBox x:Name="CharacterDifferencesOnly" DockPanel.Dock="Right" Content="Differences only" Margin="12,0,0,0" VerticalAlignment="Center" Checked="CharacterOptionChanged" Unchecked="CharacterOptionChanged"/><TextBlock x:Name="CharacterComparisonText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/></DockPanel></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <Grid>
        <DataGrid x:Name="CharacterGrid" SelectionChanged="CharacterSelected" AutomationProperties.Name="Characters">
         <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding Character.IdText}" Width="66" MinWidth="66"/>
          <DataGridTextColumn Header="Character" Binding="{Binding Character.Name}" Width="*" MinWidth="90"/>
          <DataGridTextColumn Header="Class" Binding="{Binding Character.ClassName}" Width="1.6*" MinWidth="175"/>
          <DataGridTextColumn Header="Level" Binding="{Binding Character.Level}" Width="56" MinWidth="56"/>
          <DataGridTextColumn Header="HP %" Binding="{Binding Character.HpGrowth}" Width="60" MinWidth="60"/>
          <DataGridTextColumn Header="Str %" Binding="{Binding Character.StrengthGrowth}" Width="60" MinWidth="60"/>
          <DataGridTextColumn Header="Def %" Binding="{Binding Character.DefenseGrowth}" Width="60" MinWidth="60"/>
          <DataGridTextColumn Header="Agi %" Binding="{Binding Character.AgilityGrowth}" Width="60" MinWidth="60"/>
          <DataGridTextColumn Header="Status" Binding="{Binding EditedText}" Width="74" MinWidth="74"/>
          <DataGridTextColumn x:Name="CharacterChangeColumn" Header="Comparison" Binding="{Binding Comparison}" Visibility="Collapsed" Width="100" MinWidth="100"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoCharacters" Text="No characters match this search." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="18">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
        <DockPanel Margin="0,0,0,14"><Button x:Name="EditCharacterButton" DockPanel.Dock="Right" Content="_Edit" Style="{StaticResource SmallButton}" Click="BeginCharacterEdit" ToolTip="Edit this character (Ctrl+E)" Visibility="Collapsed"/><TextBlock Text="CHARACTER DETAILS" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock x:Name="CharacterName" Text="Select a character" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap"/>
        <TextBlock x:Name="CharacterIdentity" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,6"/>
        <StackPanel x:Name="CharacterFields"/>
        <StackPanel x:Name="CharacterEditorPanel" Visibility="Collapsed"/>
        <TextBlock x:Name="CharacterComparisonDetail" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <TextBlock Grid.Row="3" x:Name="CharacterCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="ClassPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,10,0"><TextBox x:Name="ClassSearch" TextChanged="ClassFilterChanged" AutomationProperties.Name="Search classes" ToolTip="Search by name or ID (Ctrl+F)"/><TextBlock x:Name="ClassSearchHint" Text="Search by name or ID" IsHitTestVisible="False" Foreground="#899286" VerticalAlignment="Center" Margin="12,0"/></Grid>
      <CheckBox Grid.Column="1" x:Name="StartingClassesOnly" Content="Starting classes only" Margin="6,0,0,0" VerticalAlignment="Center" Checked="ClassOptionChanged" Unchecked="ClassOptionChanged"/>
     </Grid>
     <Border Grid.Row="1" x:Name="ClassComparisonBar" Visibility="Collapsed" Background="#EAF0E5" CornerRadius="5" Padding="12" Margin="0,0,0,12"><DockPanel><CheckBox x:Name="ClassDifferencesOnly" DockPanel.Dock="Right" Content="Differences only" Margin="12,0,0,0" VerticalAlignment="Center" Checked="ClassOptionChanged" Unchecked="ClassOptionChanged"/><TextBlock x:Name="ClassComparisonText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/></DockPanel></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <Grid>
        <DataGrid x:Name="ClassGrid" SelectionChanged="ClassSelected" AutomationProperties.Name="Classes">
         <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding Class.IdText}" Width="60" MinWidth="60"/>
          <DataGridTextColumn Header="Class" Binding="{Binding Class.Name}" Width="*" MinWidth="150"/>
          <DataGridTextColumn Header="HP" Binding="{Binding Class.Hp}" Width="54" MinWidth="54"/>
          <DataGridTextColumn Header="Str" Binding="{Binding Class.Strength}" Width="54" MinWidth="54"/>
          <DataGridTextColumn Header="Def" Binding="{Binding Class.Defense}" Width="54" MinWidth="54"/>
          <DataGridTextColumn Header="Agi" Binding="{Binding Class.Agility}" Width="54" MinWidth="54"/>
          <DataGridTextColumn Header="Mind" Binding="{Binding Class.Mind}" Width="60" MinWidth="60"/>
          <DataGridTextColumn Header="Move" Binding="{Binding Class.Move}" Width="60" MinWidth="60"/>
          <DataGridTextColumn Header="Status" Binding="{Binding EditedText}" Width="78" MinWidth="78"/>
          <DataGridTextColumn x:Name="ClassChangeColumn" Header="Comparison" Binding="{Binding Comparison}" Visibility="Collapsed" Width="100" MinWidth="100"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoClasses" Text="No classes match these filters." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="18">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
        <DockPanel Margin="0,0,0,14"><Button x:Name="EditClassButton" DockPanel.Dock="Right" Content="_Edit" Style="{StaticResource SmallButton}" Click="BeginClassEdit" ToolTip="Edit this class (Ctrl+E)" Visibility="Collapsed"/><TextBlock Text="CLASS DETAILS" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock x:Name="ClassName" Text="Select a class" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap"/>
        <TextBlock x:Name="ClassIdentity" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,6"/>
        <StackPanel x:Name="ClassFields"/>
        <StackPanel x:Name="ClassEditorPanel" Visibility="Collapsed"/>
        <TextBlock x:Name="ClassComparisonDetail" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <TextBlock Grid.Row="3" x:Name="ClassCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="MovementPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#EAF0E5" CornerRadius="5" Padding="12" Margin="0,0,0,12"><TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Text="Every class has a movement type. Each hex costs the points shown for its terrain, and a unit keeps moving while the total stays within its Move. Costs can use tenths, such as 1.5. Choose which type a class uses on the Classes page."/></Border>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <DataGrid x:Name="MovementGrid" SelectionChanged="MovementSelected" AutomationProperties.Name="Movement types">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Movement type" Binding="{Binding Type.Name}" Width="*" MinWidth="120"/>
         <DataGridTextColumn Header="Classes" Binding="{Binding ClassCount}" Width="66" MinWidth="66"/>
         <DataGridTextColumn Header="Plain" Binding="{Binding Plain}" Width="56" MinWidth="56"/>
         <DataGridTextColumn Header="Forest" Binding="{Binding Forest}" Width="60" MinWidth="60"/>
         <DataGridTextColumn Header="Hills" Binding="{Binding MountainFoot}" Width="54" MinWidth="54"/>
         <DataGridTextColumn Header="Sand" Binding="{Binding Sand}" Width="54" MinWidth="54"/>
         <DataGridTextColumn Header="Snow forest" Binding="{Binding SnowForest}" Width="88" MinWidth="88"/>
         <DataGridTextColumn Header="Status" Binding="{Binding EditedText}" Width="70" MinWidth="70"/>
        </DataGrid.Columns>
       </DataGrid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="18">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
        <DockPanel Margin="0,0,0,14"><Button x:Name="EditMovementButton" DockPanel.Dock="Right" Content="_Edit" Style="{StaticResource SmallButton}" Click="BeginMovementEdit" ToolTip="Edit these terrain costs (Ctrl+E)" Visibility="Collapsed"/><TextBlock Text="TERRAIN COSTS" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock x:Name="MovementName" Text="Select a movement type" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap"/>
        <TextBlock x:Name="MovementIdentity" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,6" TextWrapping="Wrap"/>
        <StackPanel x:Name="MovementFields"/>
        <StackPanel x:Name="MovementEditorPanel" Visibility="Collapsed"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <TextBlock Grid.Row="2" x:Name="MovementCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="TerrainPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#EAF0E5" CornerRadius="5" Padding="12" Margin="0,0,0,12"><TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Text="Each kind of terrain has an avoid bonus for the unit standing on it, a change to recovery while resting, and whether flying units may end their move there. What each kind costs to cross is set per movement type on the Movement page."/></Border>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <DataGrid x:Name="TerrainGrid" SelectionChanged="TerrainSelected" AutomationProperties.Name="Terrain kinds">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Terrain" Binding="{Binding Name}" Width="*" MinWidth="160"/>
         <DataGridTextColumn Header="Avoid" Binding="{Binding Avoid}" Width="58" MinWidth="58"/>
         <DataGridTextColumn Header="Recovery" Binding="{Binding Recovery}" Width="76" MinWidth="76"/>
         <DataGridTextColumn Header="Flyers stop" Binding="{Binding Flyers}" Width="104" MinWidth="104"/>
         <DataGridTextColumn Header="Status" Binding="{Binding EditedText}" Width="70" MinWidth="70"/>
        </DataGrid.Columns>
       </DataGrid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="18">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
        <DockPanel Margin="0,0,0,14"><Button x:Name="EditTerrainButton" DockPanel.Dock="Right" Content="_Edit" Style="{StaticResource SmallButton}" Click="BeginTerrainEdit" ToolTip="Edit this terrain (Ctrl+E)" Visibility="Collapsed"/><TextBlock Text="TERRAIN" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock x:Name="TerrainName" Text="Select a terrain" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap"/>
        <TextBlock x:Name="TerrainIdentity" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,6" TextWrapping="Wrap"/>
        <StackPanel x:Name="TerrainFields"/>
        <StackPanel x:Name="TerrainEditorPanel" Visibility="Collapsed"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <TextBlock Grid.Row="2" x:Name="TerrainCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="ShopsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#EAF0E5" CornerRadius="5" Padding="12" Margin="0,0,0,12"><TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Text="What each shop sells: the shops at the base and the shops on battle maps. An item is always for sale, sold from a stock that refills over time, or a special purchase that sets off an event when bought. Choose a shop to change, add or remove its items; the changes go into the shop's script when you export a disc. The stable and the furniture shop have their own pages."/></Border>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <DataGrid x:Name="ShopGrid" SelectionChanged="ShopSelected" AutomationProperties.Name="Shops">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Shop" Binding="{Binding Name}" Width="*" MinWidth="160"/>
         <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="1.3*" MinWidth="160"/>
         <DataGridTextColumn Header="Items" Binding="{Binding Count}" Width="60" MinWidth="50"/>
         <DataGridTextColumn Header="Status" Binding="{Binding EditedText}" Width="70" MinWidth="70"/>
        </DataGrid.Columns>
       </DataGrid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="18">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="SHOP" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1"><TextBlock x:Name="ShopName" Text="Select a shop" FontFamily="Georgia" FontSize="20" TextWrapping="Wrap"/><TextBlock x:Name="ShopWhere" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/></StackPanel>
        <ListBox Grid.Row="2" x:Name="ShopItemList" SelectionChanged="ShopItemSelected" DisplayMemberPath="Text" SelectedValuePath="Value" BorderBrush="{StaticResource Line}" AutomationProperties.Name="Items in this shop"/>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
         <TextBlock x:Name="ShopItemNote" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
         <WrapPanel>
          <Button x:Name="ChangeShopItemButton" Content="Change item" Style="{StaticResource SmallButton}" Click="BeginChangeShopItem" Margin="0,0,6,6" IsEnabled="False"/>
          <Button x:Name="AddShopItemButton" Content="Add item" Style="{StaticResource SmallButton}" Click="BeginAddShopItem" Margin="0,0,6,6" IsEnabled="False"/>
          <Button x:Name="RemoveShopItemButton" Content="Remove item" Style="{StaticResource SmallButton}" Click="RemoveShopItem" Margin="0,0,6,6" IsEnabled="False"/>
         </WrapPanel>
         <StackPanel x:Name="ShopItemPicker" Visibility="Collapsed" Margin="0,4,0,0">
          <TextBlock x:Name="ShopPickerLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
          <ComboBox x:Name="ShopItemChoice" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="Text" SelectedValuePath="Value" Margin="0,0,0,6" AutomationProperties.Name="Item"/>
          <TextBlock x:Name="ShopPickerError" Foreground="#9A3B2E" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
           <Button Content="Cancel" Style="{StaticResource SmallButton}" Click="CancelShopPicker" Margin="0,0,6,0"/>
           <Button Content="Apply" Style="{StaticResource SmallButton}" Click="ApplyShopPicker" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"/>
          </StackPanel>
         </StackPanel>
         <StackPanel x:Name="ShopNotes" Margin="0,6,0,0"/>
        </StackPanel>
       </Grid>
      </Border>
     </Grid>
     <TextBlock Grid.Row="2" x:Name="ShopCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="FurniturePage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#EAF0E5" CornerRadius="5" Padding="12" Margin="0,0,0,12"><TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Text="The pieces the furniture shop sells and what each one costs. The price is set by the shop's own script, separately from item prices. The shop charges the price set here, and the export also writes it into the shop's list of pieces, which keeps the order of the original prices."/></Border>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <DataGrid x:Name="FurnitureGrid" SelectionChanged="FurnitureSelected" AutomationProperties.Name="Furniture">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Piece" Binding="{Binding Name}" Width="*" MinWidth="160"/>
         <DataGridTextColumn Header="Price" Binding="{Binding PriceText}" Width="100" MinWidth="90"/>
         <DataGridTextColumn Header="Status" Binding="{Binding EditedText}" Width="70" MinWidth="70"/>
        </DataGrid.Columns>
       </DataGrid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="18">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
        <DockPanel Margin="0,0,0,14"><Button x:Name="EditFurnitureButton" DockPanel.Dock="Right" Content="_Edit" Style="{StaticResource SmallButton}" Click="BeginFurnitureEdit" ToolTip="Edit this price (Ctrl+E)" Visibility="Collapsed"/><TextBlock Text="FURNITURE" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock x:Name="FurnitureName" Text="Select a piece" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap"/>
        <StackPanel x:Name="FurnitureFields" Margin="0,8,0,0"/>
        <StackPanel x:Name="FurnitureEditorPanel" Visibility="Collapsed"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <TextBlock Grid.Row="2" x:Name="FurnitureCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="EventsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <Border Grid.ColumnSpan="5" Background="#EAF0E5" CornerRadius="5" Padding="14,12,14,12" Margin="0,0,0,14">
      <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Text="The game's event scripts, shown as readable commands: story scenes, map events and base events. Values are numbers, text or local values (v0, v1 and so on); if and else show the branches. Commands carry the names the game itself gives them. The numbers in a script can be changed on the Numbers tab, its lines added, copied, removed or moved on the Lines tab, and the whole script edited as text with Edit text. Changes go into every copy of the event when you export a disc."/>
     </Border>
     <DockPanel Grid.Row="1">
      <TextBlock DockPanel.Dock="Top" Text="Event number or text to find, then Enter" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
      <TextBox x:Name="EventSearch" DockPanel.Dock="Top" Padding="8,6,8,6" Margin="0,0,0,8" KeyDown="EventSearchKey" ToolTip="Type an event number, or text to find in every event, then press Enter" AutomationProperties.Name="Find an event"/>
      <ListBox x:Name="EventList" SelectionChanged="EventSelected" BorderBrush="{StaticResource Line}"/>
     </DockPanel>
     <DockPanel Grid.Row="1" Grid.Column="2">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="EditTextButton" Content="Edit text" Style="{StaticResource SmallButton}" Click="BeginTextEdit" ToolTip="Change the script as text" IsEnabled="False"/>
        <Button x:Name="CancelTextButton" Content="Cancel" Style="{StaticResource SmallButton}" Click="CancelTextEdit" Margin="6,0,0,0" Visibility="Collapsed"/>
        <Button x:Name="ApplyTextButton" Content="Apply text" Style="{StaticResource SmallButton}" Click="ApplyTextEdit" Margin="6,0,0,0" Visibility="Collapsed" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"/>
       </StackPanel>
       <TextBlock x:Name="EventTextNote" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/>
      </DockPanel>
      <TextBox x:Name="EventText" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Background="White" BorderBrush="{StaticResource Line}" Padding="10,8,10,8"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AutomationProperties.Name="Event script"/>
     </DockPanel>
     <Border Grid.Row="1" Grid.Column="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10">
      <TabControl x:Name="ScriptTabs" BorderThickness="0" Padding="4,8,4,4">
       <TabItem Header="Numbers">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <DockPanel Margin="0,0,0,8"><Button x:Name="EditScriptNumberButton" DockPanel.Dock="Right" Content="_Edit" Style="{StaticResource SmallButton}" Click="BeginScriptNumberEdit" ToolTip="Change this number (Ctrl+E)" Visibility="Collapsed"/><TextBlock Text="NUMBERS IN THIS EVENT" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
         <ListBox Grid.Row="1" x:Name="ScriptNumberList" SelectionChanged="ScriptNumberSelected" DisplayMemberPath="Text" SelectedValuePath="Value" BorderBrush="{StaticResource Line}" AutomationProperties.Name="Numbers in this event"/>
         <ScrollViewer Grid.Row="2" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
          <StackPanel Margin="0,0,8,0"><StackPanel x:Name="ScriptNumberFields"/><StackPanel x:Name="ScriptNumberEditor" Visibility="Collapsed"/></StackPanel>
         </ScrollViewer>
        </Grid>
       </TabItem>
       <TabItem Header="Lines">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="LINES OF THIS EVENT" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <ListBox Grid.Row="1" x:Name="ScriptLineList" SelectionChanged="ScriptLineSelected" DisplayMemberPath="Text" SelectedValuePath="Value" FontFamily="Consolas" FontSize="12" BorderBrush="{StaticResource Line}" AutomationProperties.Name="Lines of this event"/>
         <WrapPanel Grid.Row="2" Margin="0,8,0,0">
          <Button x:Name="AddLineButton" Content="Add after" Style="{StaticResource SmallButton}" Click="BeginAddLine" Margin="0,0,6,6" ToolTip="Add a command after the selected line"/>
          <Button x:Name="DuplicateLineButton" Content="Duplicate" Style="{StaticResource SmallButton}" Click="DuplicateLine" Margin="0,0,6,6" ToolTip="Add a copy of the selected line after it"/>
          <Button x:Name="RemoveLineButton" Content="Remove" Style="{StaticResource SmallButton}" Click="RemoveLine" Margin="0,0,6,6" ToolTip="Remove the selected line (with the lines under it, for if and while)"/>
          <Button x:Name="LineUpButton" Content="Up" Style="{StaticResource SmallButton}" Click="MoveLineUp" Margin="0,0,6,6" ToolTip="Move the selected line up within its part of the script"/>
          <Button x:Name="LineDownButton" Content="Down" Style="{StaticResource SmallButton}" Click="MoveLineDown" Margin="0,0,6,6" ToolTip="Move the selected line down within its part of the script"/>
         </WrapPanel>
         <StackPanel Grid.Row="3">
          <StackPanel x:Name="AddLinePanel" Visibility="Collapsed" Margin="0,4,0,0">
           <TextBlock Text="Command" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
           <ComboBox x:Name="AddLineCommand" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="Text" SelectedValuePath="Value" SelectionChanged="AddLineCommandChanged" Margin="0,0,0,4" AutomationProperties.Name="Command to add"/>
           <TextBlock x:Name="AddLineHint" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
           <TextBlock Text="Arguments, separated by commas" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
           <TextBox x:Name="AddLineArguments" Padding="6,4,6,4" FontFamily="Consolas" Margin="0,0,0,4" ToolTip="Numbers, text in double quotes, or local values such as v0" AutomationProperties.Name="Arguments of the command"/>
           <TextBlock x:Name="AddLineError" Foreground="#9A3B2E" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SmallButton}" Click="CancelAddLine" Margin="0,0,6,0"/>
            <Button Content="Add" Style="{StaticResource SmallButton}" Click="ApplyAddLine" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"/>
           </StackPanel>
          </StackPanel>
          <StackPanel x:Name="ScriptLineNotes" Margin="0,6,0,0"/>
         </StackPanel>
        </Grid>
       </TabItem>
      </TabControl>
     </Border>
     <TextBlock Grid.Row="2" Grid.ColumnSpan="5" x:Name="EventCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="MapsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
     <Border Grid.ColumnSpan="5" Background="#EAF0E5" CornerRadius="5" Padding="14,12,14,12" Margin="0,0,0,14">
      <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Text="Each battle's map as the game paints it, with the terrain of every hex, where every unit stands when the battle opens, which units arrive later and on which turn, where you can place your own units, and the spots that add a command to a unit's menu, such as gates, chests, villages to search and places to seize. Hover over a hex to see its position, terrain and the unit on it. This page is for reading."/>
     </Border>
     <ListBox Grid.Row="1" x:Name="MapList" SelectionChanged="MapSelected" BorderBrush="{StaticResource Line}" DisplayMemberPath="Text" SelectedValuePath="Value" AutomationProperties.Name="Battles"/>
     <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10,12,0">
        <CheckBox x:Name="MapArtBox" Content="Map art" IsChecked="True" Click="MapViewChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="The map as it is painted in the game"/>
        <CheckBox x:Name="MapTerrainBox" Content="Terrain colors" IsChecked="False" Click="MapViewChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Color each hex by its terrain"/>
        <CheckBox x:Name="MapUnitsBox" Content="Units" IsChecked="True" Click="MapViewChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Show where units stand when the battle starts"/>
        <CheckBox x:Name="MapArrivalsBox" Content="Arrivals" IsChecked="True" Click="MapViewChanged" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Show where units arrive later, and on which turn"/>
        <TextBlock Text="Size" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
        <ComboBox x:Name="MapSizeBox" Width="90" SelectedIndex="1" SelectionChanged="MapViewChanged" AutomationProperties.Name="Map size">
         <ComboBoxItem Content="Small"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Large"/>
        </ComboBox>
       </StackPanel>
       <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="MapCanvas" Margin="12" ClipToBounds="True" AutomationProperties.Name="Battle map"/></ScrollViewer>
      </DockPanel>
     </Border>
     <Border Grid.Row="1" Grid.Column="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="MapDetails" Margin="0,0,8,0"/></ScrollViewer>
     </Border>
     <TextBlock Grid.Row="2" Grid.ColumnSpan="5" x:Name="MapCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <ScrollViewer x:Name="MechanicsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MechanicsList" Margin="0,0,8,0" MaxWidth="860" HorizontalAlignment="Left"/></ScrollViewer>
    <ScrollViewer x:Name="SkillsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SkillsList" Margin="0,0,8,0" MaxWidth="820" HorizontalAlignment="Left"/></ScrollViewer>
    <Grid x:Name="LivePage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#EAF0E5" CornerRadius="5" Padding="14,12,14,12" Margin="0,0,0,12">
      <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Text="Change the game while it runs in PCSX2: the units on the current map, their class, level, HP, bonuses, weapon levels, skills and items, this project's rules, and which battle the next sortie loads. Changes last until you undo them or load a save; nothing on the disc or in your saves is changed. Berwick Workshop connects only to PCSX2 on this computer, through PINE, and only after you choose Connect. Turn PINE on in PCSX2 (Settings, Advanced) and keep the default slot 28011."/>
     </Border>
     <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
      <Button x:Name="LiveConnectButton" DockPanel.Dock="Left" Content="Connect" Style="{StaticResource SmallButton}" Click="LiveConnect" Margin="0,0,8,0"/>
      <Button x:Name="LiveRefreshButton" DockPanel.Dock="Left" Content="Refresh units" Style="{StaticResource SmallButton}" Click="LiveRefresh" Margin="0,0,8,0" IsEnabled="False"/>
      <Button x:Name="LiveRulesButton" DockPanel.Dock="Left" Content="Try this project's rules" Style="{StaticResource SmallButton}" Click="LiveTryRules" Margin="0,0,8,0" IsEnabled="False" ToolTip="Write every rule changed in this project into the running game"/>
      <Button x:Name="LiveUndoButton" DockPanel.Dock="Left" Content="Undo all changes" Style="{StaticResource SmallButton}" Click="LiveUndo" Margin="0,0,12,0" IsEnabled="False" ToolTip="Put back everything Berwick Workshop changed in the running game"/>
      <TextBlock x:Name="LiveStatus" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Text="Not connected."/>
     </DockPanel>
     <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" Text="Next sortie loads" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
      <ComboBox x:Name="LiveBattleBox" DockPanel.Dock="Left" Width="320" Margin="0,0,8,0" IsEnabled="False" DisplayMemberPath="Text" SelectedValuePath="Value" AutomationProperties.Name="Battle for the next sortie"/>
      <Button x:Name="LiveSendButton" DockPanel.Dock="Left" Content="Send sorties there" Style="{StaticResource SmallButton}" Click="LiveSendSorties" Margin="0,0,8,0" IsEnabled="False" ToolTip="Every story mission and quest started from the base loads this battle"/>
      <Button x:Name="LiveOwnBattlesButton" DockPanel.Dock="Left" Content="Use each sortie's own battle" Style="{StaticResource SmallButton}" Click="LiveOwnBattles" Margin="0,0,12,0" IsEnabled="False"/>
      <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Text="Choose at the base, then start any mission or quest: its map, units and events are those of the chosen battle."/>
     </DockPanel>
     <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
       <Grid>
        <DataGrid x:Name="LiveGrid" SelectionChanged="LiveUnitSelected" AutomationProperties.Name="Units on the map">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="90" MinWidth="80"/>
          <DataGridTextColumn Header="Unit" Binding="{Binding Unit.Name}" Width="*" MinWidth="120"/>
          <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="1.3*" MinWidth="140"/>
          <DataGridTextColumn Header="Level" Binding="{Binding Unit.Level}" Width="56" MinWidth="56"/>
          <DataGridTextColumn Header="HP" Binding="{Binding Unit.Hp}" Width="50" MinWidth="50"/>
          <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="76" MinWidth="70"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoLiveUnits" Text="Connect to see the units on the current map." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="18">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
        <TextBlock Text="UNIT IN THE GAME" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock x:Name="LiveUnitName" Text="Select a unit" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap"/>
        <StackPanel x:Name="LiveEditor" Margin="0,8,0,0"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <TextBlock Grid.Row="4" x:Name="LiveCount" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </Grid>
    <ScrollViewer x:Name="RulesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="RulesList" Margin="0,0,8,0" MaxWidth="820" HorizontalAlignment="Left"/></ScrollViewer>
    <ScrollViewer x:Name="DiscPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="Disc information" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="20"><StackPanel x:Name="DiscFields"/></Border>
      <TextBlock Text="Disc files" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/>
      <DataGrid x:Name="FilesGrid" Height="350" AutomationProperties.Name="Disc files"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size in bytes" Binding="{Binding Length, StringFormat=N0}" Width="180"/></DataGrid.Columns></DataGrid>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="4" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#E1E7DC" Margin="0,0,0,10"/>
    <DockPanel Grid.Row="1"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Visibility="Collapsed" Padding="12,4" Click="CancelLoad"/><TextBlock x:Name="Status" Text="Ready" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>
